<Window x:Class="Pixory.PaletteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Pixory"
        xmlns:services="clr-namespace:Pixory.Services"
        mc:Ignorable="d"
        Title="Pixory"
        Width="320" Height="440"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="Manual"
        FontFamily="Segoe UI"
        Deactivated="OnDeactivated">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <local:ColorTextConverter x:Key="ColorText" />

        <!-- Brand + neutral palette, shared across the popup. -->
        <SolidColorBrush x:Key="Accent" Color="#6366F1" />
        <SolidColorBrush x:Key="Surface" Color="#FFFFFF" />
        <SolidColorBrush x:Key="Subtle" Color="#F3F4F6" />
        <SolidColorBrush x:Key="Border" Color="#E5E7EB" />
        <SolidColorBrush x:Key="TextPrimary" Color="#111827" />
        <SolidColorBrush x:Key="TextMuted" Color="#6B7280" />

        <!-- Palette rows: rounded, with hover and an accent-filled selection. -->
        <Style x:Key="ColorItemStyle" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" CornerRadius="6"
                                Background="Transparent"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Subtle}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Accent}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The headline "pick a colour" button. -->
        <Style x:Key="PickButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="{StaticResource Accent}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="8"
                                Background="{TemplateBinding Background}"
                                Padding="10,9">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#4F46E5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Outer margin leaves room for the drop shadow; the card is the Border. -->
    <Border Margin="12" CornerRadius="12"
            Background="{StaticResource Surface}"
            BorderBrush="{StaticResource Border}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="#000000" Opacity="0.22"
                              BlurRadius="20" ShadowDepth="0" />
        </Border.Effect>

        <Grid Margin="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header: brand mark + live colour count. -->
            <Grid Grid.Row="0" Margin="2,0,2,10">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="14" Height="14" CornerRadius="4"
                            Background="{StaticResource Accent}" />
                    <TextBlock Text="Pixory" Margin="8,0,0,0"
                               FontWeight="SemiBold" FontSize="13"
                               Foreground="{StaticResource TextPrimary}"
                               VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center"
                           FontSize="11" Foreground="{StaticResource TextMuted}"
                           Text="{Binding Items.Count, ElementName=PaletteList}" />
            </Grid>

            <!-- Headline action: start picking a colour off the screen. -->
            <Button Grid.Row="1" Margin="0,0,0,8"
                    Style="{StaticResource PickButtonStyle}"
                    Click="OnPickClick"
                    Content="{Binding [TrayPick], Source={x:Static services:Localization.Instance}}" />

            <!-- The palette, plus an empty-state message behind it. -->
            <Grid Grid.Row="2">
                <ListBox x:Name="PaletteList"
                         Background="Transparent" BorderThickness="0"
                         HorizontalContentAlignment="Stretch"
                         ItemContainerStyle="{StaticResource ColorItemStyle}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         MouseDoubleClick="OnListDoubleClick">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Colour swatch. -->
                                <Border Grid.Column="0" Width="22" Height="22"
                                        CornerRadius="5" Background="{Binding Swatch}"
                                        BorderBrush="#33000000" BorderThickness="1" />

                                <!-- The colour's value in the active format. -->
                                <TextBlock Grid.Column="1" Margin="10,0,0,0"
                                           VerticalAlignment="Center"
                                           FontFamily="Consolas, Cascadia Mono, monospace"
                                           FontSize="13"
                                           TextTrimming="CharacterEllipsis">
                                    <TextBlock.Text>
                                        <MultiBinding Converter="{StaticResource ColorText}">
                                            <Binding />
                                            <Binding Path="Format"
                                                     Source="{x:Static services:FormatState.Instance}" />
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>

                                <!-- Amber star marks pinned colours. -->
                                <TextBlock Grid.Column="2" Text="★" Margin="8,0,0,0"
                                           VerticalAlignment="Center" Foreground="#F59E0B"
                                           Visibility="{Binding IsPinned, Converter={StaticResource BoolToVis}}" />

                                <Grid.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="{Binding [MenuPin], Source={x:Static services:Localization.Instance}}"
                                                  Click="OnPinClick" />
                                        <MenuItem Header="{Binding [MenuDelete], Source={x:Static services:Localization.Instance}}"
                                                  Click="OnDeleteClick" />
                                    </ContextMenu>
                                </Grid.ContextMenu>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock Text="{Binding [PaletteEmpty], Source={x:Static services:Localization.Instance}}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           TextAlignment="Center" TextWrapping="Wrap" MaxWidth="220"
                           FontSize="12" Foreground="{StaticResource TextMuted}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasItems, ElementName=PaletteList}" Value="False">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>

            <!-- Keyboard hint. -->
            <TextBlock Grid.Row="3" Margin="2,10,2,0"
                       FontSize="11" Foreground="{StaticResource TextMuted}"
                       TextWrapping="Wrap"
                       Text="{Binding [Hint], Source={x:Static services:Localization.Instance}}" />
        </Grid>
    </Border>
</Window>
